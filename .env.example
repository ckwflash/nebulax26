# auto: Vertex when VERTEX_PROJECT is set, otherwise Gemini API key or evidence.
NIGHTSHIFT_CHAT_PROVIDER=auto
# Vertex uses Application Default Credentials (attached identity on Cloud Run).
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# Optional alternative for local development. No key is needed on Cloud Run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google Cloud Run: use the attached runtime identity, never a downloaded key.
NIGHTSHIFT_GCS_BUCKET=
NIGHTSHIFT_SOLVER_THREADS=4
# Cloudflare R2 checkpoint gateway. Set these only for hosted deployments.
NIGHTSHIFT_SNAPSHOT_URL=
NIGHTSHIFT_INTERNAL_SECRET=
