{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nightshift-planner",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"],
  },
  "containers": [
    {
      "class_name": "Planner",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Planner", "name": "PLANNER" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Planner"] }],
  "r2_buckets": [
    { "binding": "SNAPSHOTS", "bucket_name": "nightshift-snapshots" },
  ],
  "vars": { "GEMINI_MODEL": "gemini-3.8-flash" },
  "observability": { "enabled": true },
}
